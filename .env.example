# Google Cloud & Gemini platform (ADC on Cloud Run; global endpoint recommended)
GOOGLE_CLOUD_PROJECT=brewspace-ai-mvp-2026
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Set to "memory" for local dev without Firestore credentials, or "firestore" for Cloud Firestore
BREWSPACE_STORE_MODE=memory

# Firebase Web SDK (public client config from `npx -y firebase-tools@latest apps:sdkconfig WEB`)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=brewspace-ai-mvp-2026
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only secret (injected from Secret Manager on Cloud Run — never commit real values)
BREWSPACE_DEMO_ADMIN_SECRET=local-dev-only-change-me
